summary: Basic CA — IPACTA (FreeIPA-only)
description: |
  Full mapped parity with Dogtag TMT ca-basic-test
  (pki branch idm-8254-tmt-ca-basic / GHA ca-basic-test.yml).
  FreeIPA-only: one container, ipa-server-install --internal-ca.

  Prepare builds freeipa-ipacta from Fedora 46 packages
  (freeipa-server + ipacta + freeipa-healthcheck). A clean Testing
  Farm guest only needs Docker and registry.fedoraproject.org.

  See tests/tmt/ca-basic-test/README.md
discover:
    how: fmf
    test:
        - /tests/tmt/ca-basic-test
provision:
    how: local
prepare:
    - name: require-docker
      how: shell
      script:
        - |
          set -euo pipefail
          if ! command -v docker >/dev/null 2>&1; then
            echo "==== Installing Docker (moby-engine) ===="
            dnf install -y moby-engine containerd
          fi
          # enable/start can time out when the daemon is already up
          systemctl enable docker 2>/dev/null || true
          systemctl start docker 2>/dev/null || true
          docker info >/dev/null
          echo "==== Docker ready ===="
    - name: build-ipa-runner
      how: shell
      script:
        - |
          # Fedora 46 + packaged IPACTA (not makerpms / in-tree)
          "${TMT_TREE}/tests/tmt/bin/build-ipa-runner.sh" "${TMT_TREE}"
execute:
    how: tmt
finish:
    how: shell
    script:
      - |
        docker rm -f ipa 2>/dev/null || true
        docker network rm example 2>/dev/null || true
tag:
    - ca
    - ipacta
    - idm-8254
    - tier1
link:
    - verifies: https://redhat.atlassian.net/browse/IDM-8254
    - relates: https://github.com/dogtagpki/pki/blob/master/.github/workflows/ca-basic-test.yml
    - relates: https://packages.fedoraproject.org/pkgs/ipacta/
